# App — single source of truth for dev port, auth redirects, and Supabase hook URL.
# After changing this, run: pnpm sync:env && pnpm db:stop && pnpm db:start
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Auto-filled by pnpm sync:env — do not edit manually
# SUPABASE_SEND_EMAIL_HOOK_URI=
# SUPABASE_AUTH_REDIRECT_URLS=

# Supabase — filled automatically by `pnpm db:setup` when using Docker locally.
# For cloud: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Auth Send Email Hook — local dev default is set by db:setup; generate a new secret for production
SEND_EMAIL_HOOK_SECRET=

# Stripe — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Mailtrap — https://mailtrap.io/api-tokens
MAILTRAP_API_TOKEN=
# Optional: Mailtrap Account ID (removes SDK "accountId is missing" warning in testing mode)
MAILTRAP_ACCOUNT_ID=
# Local dev: true = capture in Email Testing inbox (no real delivery). Production: false or unset.
MAILTRAP_SANDBOX=true
# Inbox ID from Mailtrap → Email Testing → your inbox → inbox settings
MAILTRAP_TEST_INBOX_ID=
MAILTRAP_WEBHOOK_SECRET=
MAILTRAP_FROM_EMAIL=no-reply@your-domain.com
MAILTRAP_FROM_NAME=Your App

# Hosted template UUIDs — https://mailtrap.io/email-templates
MAILTRAP_TPL_WELCOME=
MAILTRAP_TPL_MAGIC_LINK=
MAILTRAP_TPL_RESET_PASSWORD=
MAILTRAP_TPL_TEAM_INVITE=
MAILTRAP_TPL_PAYMENT_RECEIPT=
MAILTRAP_TPL_DUNNING=
MAILTRAP_TPL_CANCELLATION=
MAILTRAP_TPL_PLAN_CHANGE=

# Comma-separated admin emails for /admin/emails
ADMIN_EMAILS=you@company.com
